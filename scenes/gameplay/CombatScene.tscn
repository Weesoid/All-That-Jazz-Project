[sub_resource type="GDScript" id="GDScript_25yyp"]
script/source = "extends ProgressBar

@onready var combat_scene = CombatGlobals.getCombatScene()

func _process(_delta):
	max_value = combat_scene.turn_time
	value = combat_scene.turn_timer.time_left
"

