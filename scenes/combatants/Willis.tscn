[sub_resource type="GDScript" id="GDScript_5albt"]
script/source = "extends Label

var resource

func _ready():
	resource = get_parent().combatant_resource

func _process(delta):
	if resource == null: 
		queue_free()
		return
	
	text = 'BLOCK: %s' % resource.stat_values.get('block',0)
"

