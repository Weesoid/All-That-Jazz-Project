script/source = "extends Area2D


func _on_body_entered(body):
	if body is PlayerScene:
		await get_tree().create_timer(1).timeout
		OverworldGlobals.playMusic(\"res://audio/music/706196__garuda1982__sad-electric-guitar-loop-for-background-music.ogg\",-6)
		queue_free()
"

