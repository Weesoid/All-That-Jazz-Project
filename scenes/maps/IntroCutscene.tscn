[sub_resource type="GDScript" id="GDScript_07bhj"]
script/source = "extends CharacterBody2D

@export var gravity = 980
@export var friction = 999 # 500
@onready var sprite = $SplinteredStick

func splinter():
	for child in OverworldGlobals.getCurrentMap().get_children().filter(func(chimp): return chimp is CharacterBody2D):
		add_collision_exception_with(child)
	show()
	#add_collision_exception_with(OverworldGlobals.player)
	print('MOVING!')
	global_position = $\"../Mother/Marker2D\".global_position
	velocity += Vector2(-75,-275)

func _physics_process(delta):
	if !is_on_floor():
		velocity.y += gravity * delta
		sprite.rotation_degrees += 12
	else:
		velocity.x = move_toward(velocity.x, 0, friction * delta)
		print(sprite.rotation_degrees)
		#sprite.rotation_degrees = move_toward(sprite.rotation_degrees, 0, gravity * delta)
	
	move_and_slide()
"

